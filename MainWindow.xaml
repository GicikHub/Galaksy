<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEON CYBER LAB - GALAXY &amp; ABYSSAL RIFT 3D"
        Width="1300" Height="850"
        MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#080614"
        MouseWheel="Window_MouseWheel"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="GalaxyButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#4C1D95"/>
            <Setter Property="Background" Value="#1E1B4B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#312E81"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#EC4899"/>
                                <Setter Property="Foreground" Value="#00F5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="✦ NEON CYBER LAB • MULTIVERSE &amp; ABYSSAL RIFT" Foreground="#EC4899" FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="ADVANCED COSMIC SIMULATOR 3D" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                <TextBlock Text="USE MOUSE WHEEL TO ZOOM IN/OUT • 3D ORBITAL &amp; RIFT SIMULATION" Foreground="#A78BFA" FontSize="10" Margin="0,4,0,0"/>
            </StackPanel>

            <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="8" BorderBrush="#00F5FF" BorderThickness="1" Background="#1E1B4B" Padding="12,8">
                <TextBlock x:Name="StatusBlock" Text="● SIMULATION ONLINE" Foreground="#00F5FF" FontWeight="Bold" FontSize="11"/>
            </Border>
        </Grid>

        <!-- MAIN AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="245"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: CONTROL DECK -->
            <Border Grid.Column="0" Background="#110C26" BorderBrush="#3B0764" BorderThickness="1" CornerRadius="12" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="◈ GALAXY DECK" Foreground="#EC4899" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Button Content="⚡ WARP SPEED" Style="{StaticResource GalaxyButton}" Click="Warp_Click"/>
                        <Button Content="🌌 SPIRAL GALAXY" Style="{StaticResource GalaxyButton}" Click="SpiralGalaxy_Click"/>
                        <Button Content="🌀 ABYSSAL RIFT" Style="{StaticResource GalaxyButton}" Background="#3B0764" Click="AbyssalRift_Click"/>
                        <Button Content="☀️ SOLAR SYSTEM 3D" Style="{StaticResource GalaxyButton}" Click="SolarSystem_Click"/>
                        <Button Content="🪐 RING GALAXY" Style="{StaticResource GalaxyButton}" Click="RingGalaxy_Click"/>
                        <Button Content="🕳️ BLACK HOLE VORTEX" Style="{StaticResource GalaxyButton}" Click="BlackHole_Click"/>
                        <Button Content="🧊 SWITCH 3D GEOMETRY" Style="{StaticResource GalaxyButton}" Click="Object_Click"/>
                        <Button Content="🔮 CHARGE NEBULA" Style="{StaticResource GalaxyButton}" Click="Charge_Click"/>
                        <Button Content="💥 RELEASE PULSE" Style="{StaticResource GalaxyButton}" Click="Release_Click"/>
                        <Button Content="🌈 GALAXY COLOR HUE" Style="{StaticResource GalaxyButton}" Click="Dimension_Click"/>
                        <Button Content="✦ STAR BURST" Style="{StaticResource GalaxyButton}" Click="StarBurst_Click"/>
                        <Button Content="⏸ PAUSE / RESUME" Style="{StaticResource GalaxyButton}" Click="Pause_Click"/>
                        <Button Content="↻ RESET UNIVERSE" Style="{StaticResource GalaxyButton}" Background="#1F2937" Click="Reset_Click"/>

                        <Border Background="#0B071E" CornerRadius="8" BorderBrush="#2E1065" BorderThickness="1" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="ZOOM &amp; MISSION TIME" Foreground="#9CA3AF" FontSize="10"/>
                                <TextBlock x:Name="ZoomBlock" Text="ZOOM: 1.0x" Foreground="#00F5FF" FontSize="14" FontWeight="Bold" Margin="0,2,0,2"/>
                                <TextBlock x:Name="ClockBlock" Text="00:00:00" Foreground="#C084FC" FontSize="19" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CENTER: 3D SPACE VIEWPORT -->
            <Border Grid.Column="2" Background="#06040F" BorderBrush="#3B0764" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,12,14,0">
                        <TextBlock x:Name="ObjectTitleBlock" Text="SPIRAL GALAXY / 3D RENDER" Foreground="#00F5FF" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="RenderModeBlock" Text="NORMAL SPEED" Foreground="#A78BFA" FontSize="10" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Grid.Row="1" ClipToBounds="True">
                        <Canvas x:Name="StarCanvas" IsHitTestVisible="False"/>
                        <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False"/>
                        <Ellipse x:Name="CoreGlow" Width="220" Height="220" Fill="#3B0764" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Canvas x:Name="CubeCanvas" IsHitTestVisible="False"/>
                    </Grid>

                    <Border Grid.Row="2" Background="#110C26" Padding="12" BorderBrush="#3B0764" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock Text="COSMIC ROTATION &amp; ZOOM ENGINE" Foreground="#A78BFA" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RotationBlock" Text="X 000°  /  Y 000°" Foreground="#00F5FF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: TELEMETRY -->
            <Border Grid.Column="4" Background="#110C26" BorderBrush="#3B0764" BorderThickness="1" CornerRadius="12" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="◈ TELEMETRY" Foreground="#EC4899" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>

                        <TextBlock Text="CORE ENERGY" Foreground="#9CA3AF" FontSize="10"/>
                        <TextBlock x:Name="EnergyBlock" Text="075" Foreground="#C084FC" FontSize="34" FontWeight="Bold" Margin="0,2,0,6"/>

                        <ProgressBar x:Name="EnergyBar" Minimum="0" Maximum="100" Value="75" Height="10" Foreground="#00F5FF" Background="#1E1B4B" BorderThickness="0"/>
                        <TextBlock x:Name="EnergyPercent" Text="75 / 100" Foreground="#00F5FF" FontSize="11" Margin="0,6,0,12"/>

                        <Border Background="#0B071E" CornerRadius="8" BorderBrush="#2E1065" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="WARP MULTIPLIER" Foreground="#9CA3AF" FontSize="10"/>
                                <TextBlock x:Name="WarpBlock" Text="1.0x" Foreground="#EC4899" FontSize="22" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0B071E" CornerRadius="8" BorderBrush="#2E1065" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="ACTIVE PARTICLES" Foreground="#9CA3AF" FontSize="10"/>
                                <TextBlock x:Name="StarsBlock" Text="0" Foreground="#00F5FF" FontSize="22" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="GALAXY LOG" Foreground="#00FFB2" FontSize="11" FontWeight="Bold" Margin="0,4,0,5"/>
                        <Border Background="#0B071E" CornerRadius="8" BorderBrush="#2E1065" BorderThickness="1" Padding="8" MinHeight="90">
                            <TextBlock x:Name="LogBlock" Text="> Multiverse engine online." Foreground="#D8B4FE" FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock x:Name="ActionsBlock" Text="ACTIONS: 0" Foreground="#A78BFA" FontWeight="Bold" FontSize="11" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="COSMIC ENGINE V7  •  WPF / C#" Foreground="#6B7280" FontSize="10"/>
            <TextBlock Text="SIMULATION ACTIVE" Foreground="#6B7280" FontSize="10" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>